// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Top-level kind of volleyball. v1 has data only for CLASSIC (AD-9); BEACH exists
/// in the type but has no create path, no UI and no Server Actions.
enum Discipline {
  CLASSIC
  BEACH
}

/// Category within a discipline (glossary "Тип турніру"). All types share the
/// same championship logic (groups → playoff).
enum TournamentType {
  CHAMPIONSHIP
  VETERAN
  WOMEN
  YOUTH
}

/// Lifecycle stage. Changed only by `transitionTournament` (Story 2.3 / AD-8) —
/// never by a direct write. Forward-only: DRAFT → GROUP_STAGE → PLAYOFF → COMPLETED.
enum TournamentState {
  DRAFT
  GROUP_STAGE
  PLAYOFF
  COMPLETED
}

/// Points rule (glossary "Система очок"). CLASSIC: match to 3 sets, 3/2/1/0 points.
/// CUSTOM: every match is exactly 3 sets, 1 point per set won. Both rules are fixed
/// in `src/domain/scoring.ts` — there is nothing per-tournament to configure.
enum ScoringPreset {
  CLASSIC
  CUSTOM
}

/// A single competition instance. The group standings table and playoff placements
/// are NEVER stored here (AD-4) — they are computed on read from matches.
model Tournament {
  id            String            @id @default(cuid())
  discipline    Discipline
  type          TournamentType
  name          String
  /// Calendar year of the competition, e.g. 2026. CHECK 2000..2100.
  year          Int
  state         TournamentState   @default(DRAFT)
  scoringPreset ScoringPreset
  /// Planned field size — the number of teams the single group is drawn for.
  /// Set at creation, editable only while DRAFT. CHECK > 0.
  teamCount     Int
  /// Round-robin passes in the group ("кількість кіл"), not playoff rounds.
  /// Set at creation, editable only while DRAFT. CHECK > 0.
  rounds        Int
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  entries       TournamentEntry[]
  group         Group?
  matches       Match[]

  @@unique([discipline, type, year, name])
  @@index([discipline, state, year])
  @@map("tournament")
}

/// The single group of a v1 tournament (Tournament 1—1 Group). Planned size is
/// Tournament.teamCount.
model Group {
  id           String      @id @default(cuid())
  tournamentId String      @unique
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  slots        GroupSlot[]
  matches      Match[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("group")
}

/// Which entries were placed into which group at draw time (Story 3.3) —
/// distinct from `TournamentEntry`, which only records participation in the
/// tournament as a whole. In v1 (exactly one `Group` per `Tournament`) every
/// entered team ends up here after the draw; the split exists so a future
/// multi-group format isn't structurally blocked.
model GroupSlot {
  id        String          @id @default(cuid())
  groupId   String
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entryId   String
  entry     TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([groupId, entryId])
  @@map("group_slot")
}

/// Stage of a `Match`. `GROUP` matches belong to a `Group` (Story 3.3); the
/// three playoff stages (Epic 4) don't — `Match.groupId` is null for them.
enum MatchStage {
  GROUP
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

/// A single game between two `TournamentEntry`s. Result lives only in
/// `SetScore` rows (AD-4) — this model carries no score/winner column.
/// `homeEntryId`/`awayEntryId` are nullable: a `FINAL`/`THIRD_PLACE` match
/// (Epic 4) is created before its participants are decided by the
/// semifinals — `domain/bracket.ts` computes them live until a real
/// `SetScore` exists (AD-5). `GROUP` matches (this story onward) always have
/// both set at creation.
model Match {
  id           String           @id @default(cuid())
  tournamentId String
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  stage        MatchStage       @default(GROUP)
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  homeEntryId  String?
  homeEntry    TournamentEntry? @relation("MatchHomeEntry", fields: [homeEntryId], references: [id], onDelete: Cascade)
  awayEntryId  String?
  awayEntry    TournamentEntry? @relation("MatchAwayEntry", fields: [awayEntryId], references: [id], onDelete: Cascade)
  /// Free text, not a real venue entity — matches `TournamentEntry`'s roster
  /// fields' precedent of plain text over a new lookup model.
  venueText    String?
  scheduledAt  DateTime?        @db.Timestamptz(3)
  sets         SetScore[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tournamentId, stage])
  @@map("match")
}

/// One set's score within a `Match`. The sole stored source of a result —
/// group standings and playoff placements are always computed from these,
/// never stored (AD-4).
model SetScore {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  setNo      Int
  homePoints Int
  awayPoints Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([matchId, setNo])
  @@index([matchId])
  @@map("set_score")
}

/// A reusable club identity (glossary "Команда"). One row is entered into many
/// tournaments via `TournamentEntry`.
model Team {
  id        String            @id @default(cuid())
  /// Display value, trimmed + whitespace-collapsed. Not itself unique —
  /// `nameKey` is the dedup anchor (Story 2.6).
  name      String
  /// Normalized dedup key: case-folded `name`. Computed in
  /// `src/domain/teamForm.ts`, never hand-edited.
  nameKey   String            @unique
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @default(now()) @updatedAt @db.Timestamptz(3)
  entries   TournamentEntry[]

  @@map("team")
}

/// A team's participation in one tournament (glossary "Заявка команди"). Owns the
/// roster (`players`), which is specific to this tournament. At most one per
/// (tournament, team). Deleting it deletes the roster (FR-9).
model TournamentEntry {
  id           String      @id @default(cuid())
  tournamentId String
  teamId       String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team        @relation(fields: [teamId], references: [id], onDelete: Restrict)
  players      Player[]
  groupSlots   GroupSlot[]
  homeMatches  Match[]     @relation("MatchHomeEntry")
  awayMatches  Match[]     @relation("MatchAwayEntry")
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([tournamentId, teamId])
  @@index([teamId])
  @@map("tournament_entry")
}

/// One roster entry (glossary "Гравець"), scoped to a single `TournamentEntry` —
/// there is no global player directory and no cross-entry dedup (PRD §4.3 / FR-10).
/// Only `fullName` is required; every other field is optional free text by design.
model Player {
  id         String          @id @default(cuid())
  entryId    String
  entry      TournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  fullName   String
  birthDate  String?
  birthPlace String?
  sportRank  String?
  position   String?
  height     String?
  weight     String?
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([entryId])
  @@map("player")
}
