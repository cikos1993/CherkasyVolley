# Reference for the environment variables the app needs.
# Local dev: run `npx vercel env pull .env.local` — it writes the real values
# (DATABASE_URL + DATABASE_URL_UNPOOLED) into .env.local, which is git-ignored.
# prisma7.config.ts loads .env.local first, then .env. Never commit real secrets.
# In production these are Vercel project environment variables.

# Neon Postgres pooled connection string (pgbouncer). App runtime / Prisma Client.
# Neon dashboard → project → Connection Details → "Pooled connection".
DATABASE_URL=

# Neon direct/unpooled connection. Prisma CLI only (migrations, introspection) —
# `prisma migrate` fails over the pooled endpoint.
# `vercel env pull` provides this as DATABASE_URL_UNPOOLED; the Prisma config falls
# back to that name, so DIRECT_URL only needs setting if you are NOT using
# `vercel env pull` (e.g. a hand-written .env).
DIRECT_URL=

# Optional: a separate empty Neon branch's direct connection, only if
# `prisma migrate dev` cannot create/drop its own shadow database.
# SHADOW_DATABASE_URL=

# --- Story 1.4: seed the first admin ---
# Email of the first admin. `pnpm seed` upserts a User with isAdmin=true for this
# address (lower-cased); the account is linked on their first Google sign-in.
SEED_ADMIN_EMAIL=

# --- Added in Story 1.5 (Google sign-in via Better Auth) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
