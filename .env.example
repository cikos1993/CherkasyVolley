# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# In production these are set as Vercel project environment variables.
# Local dev: `npx vercel env pull .env.local` populates DATABASE_URL + DATABASE_URL_UNPOOLED.

# Neon Postgres pooled connection string (pgbouncer). App runtime / Prisma Client.
# Neon dashboard → project → Connection Details → "Pooled connection".
DATABASE_URL=

# Neon direct/unpooled connection. Prisma CLI only (migrations, introspection) —
# `prisma migrate` fails over the pooled endpoint.
# Neon Connection Details → toggle "Pooled connection" OFF.
# On Vercel the Neon integration provides DATABASE_URL_UNPOOLED, which the Prisma
# config falls back to, so DIRECT_URL need not be set there.
DIRECT_URL=

# Optional: a separate empty Neon branch's direct connection, only if
# `prisma migrate dev` cannot create/drop its own shadow database.
# SHADOW_DATABASE_URL=

# --- Story 1.4: seed the first admin ---
# Email of the first admin. `pnpm seed` upserts a User with isAdmin=true for this
# address; the account is linked on their first Google sign-in.
SEED_ADMIN_EMAIL=

# --- Added in Story 1.5 (Google sign-in via Better Auth) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=
